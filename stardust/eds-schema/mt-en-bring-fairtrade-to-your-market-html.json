      "section": "RichtextSection",
      "items": [
        {
          "role": "heading",
          "order": 0,
          "text": "What is Fairtrade?"
        },
        {
          "role": "body",
          "order": 1,
          "text": "Fairtrade is the working to behind the products sold and consumed around the world."
        },
        {
          "role": "body",
          "order": 2,
          "text": "most recognised and trusted sustainability label"
        },
        {
          "role": "body",
          "order": 3,
          "text": "make trade fairer for the people"
        },
        {
          "role": "body",
          "order": 4,
          "text": "At the heart of Fairtrade are designed to create fairer trading conditions and support more sustainable production. Farmers and workers are actively involved in shaping the Fairtrade system and its standards."
        },
        {
          "role": "body",
          "order": 5,
          "text": "social, economic and environmental standards"
        }
      ],
      "imgCount": 0,
      "editableTexts": 3,
      "repeats": [
