      "items": [
        {
          "role": "heading",
          "order": 0,
          "text": "Who we are"
        },
        {
          "role": "body",
          "order": 1,
          "text": "For more than three decades, Fairtrade has been making an . We believe that every farmer and worker should have access to a better way of doing business, and a better way of living."
        },
        {
          "role": "body",
          "order": 2,
          "text": "impact on the way trade works"
        },
        {
          "role": "body",
          "order": 3,
          "text": "As a leader in the global movement to make trade fair, Fairtrade and connects farmers and workers with the people who buy their products."
        },
        {
          "role": "body",
          "order": 4,
          "text": "supports and challenges"
        },
        {
          "role": "body",
          "order": 5,
          "text": "businesses and governments"
        },
        {
          "role": "cta",
          "order": 6,
          "text": "Find out more",
          "href": "https://www.fairtrade.net/en/why-fairtrade/what-we-do/what-is-fairtrade.html"
        }
      ],
      "imgCount": 1,
      "editableTexts": 4,
