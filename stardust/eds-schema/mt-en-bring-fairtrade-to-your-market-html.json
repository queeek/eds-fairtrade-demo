      "items": [
        {
          "role": "heading",
          "order": 0,
          "text": "Which products can be Fairtrade?"
        },
        {
          "role": "body",
          "order": 1,
          "text": "There is a creating measurable impact: Coffee · Cocoa · Bananas · Tea · Sugar · Rice · Honey · Fruit and juices · Herbs and spices · Nuts, seeds and oils · Flowers and plants · Cotton · Textiles · Wine and grapes · Gold · Sports balls to find out which Fairtrade options are available for your product and supply chain."
        },
        {
          "role": "body",
          "order": 2,
          "text": "wide array Fairtrade products"
        },
        {
          "role": "cta",
          "order": 3,
          "text": "Contact our team",
