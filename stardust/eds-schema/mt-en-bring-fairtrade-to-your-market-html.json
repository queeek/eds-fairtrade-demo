    {
      "section": "TextImage--wrapper",
      "items": [
        {
          "role": "heading",
          "order": 0,
          "text": "What we do"
        },
        {
          "role": "body",
          "order": 1,
          "text": "Fairtrade changes the way trade works through for farmers and workers. We offer retail and industrial partners as well as consumers , so that farming families and workers in countries of the Global South can have ."
        },
        {
          "role": "body",
          "order": 2,
          "text": "better prices, decent working conditions and a fairer deal"
        },
        {
          "role": "body",
          "order": 3,
          "text": "concrete alternatives for action"
        },
        {
          "role": "body",
          "order": 4,
          "text": "better prospects for the future"
        },
        {
          "role": "cta",
          "order": 5,
          "text": "Find out more",
          "href": "https://www.fairtrade.net/en/why-fairtrade/what-we-do.html"
        }
      ],
      "imgCount": 1,
      "editableTexts": 3,
      "repeats": [
