    {
      "section": "TextImage--wrapper",
      "items": [
        {
          "role": "heading",
          "order": 0,
          "text": "Why we do it"
        },
        {
          "role": "body",
          "order": 1,
          "text": "We want to build a world where everyone benefits from quality products and enjoys quality of life. But this cannot be done in a silo. You cannot separate human rights from from worker’s rights, amongst others. Our looks from different dimensions to drive impact – and fairness."
        },
        {
          "role": "body",
          "order": 2,
          "text": "environmental rights, child protection from living incomes, and gender equity"
        },
        {
          "role": "body",
          "order": 3,
          "text": "holistic approach"
        },
        {
          "role": "cta",
          "order": 4,
          "text": "Find out more",
          "href": "https://www.fairtrade.net/en/why-fairtrade/why-we-do-it.html"
        }
      ],
